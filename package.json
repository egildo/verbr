{
  "name": "verbr",
  "version": "0.3.0",
  "description": "A command register for any UI over any state: capabilities declared once, taste as a document, every surface — toolbar, menu, palette, keyboard, agent — a projection, one checked door to run them.",
  "keywords": ["commands", "command-palette", "keyboard-shortcuts", "toolbar", "menu", "state-management", "agent-tools", "mcp", "json-schema", "invoker-commands"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chord": {
      "types": "./dist/chord.d.ts",
      "default": "./dist/chord.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./outlet": {
      "types": "./dist/outlet.d.ts",
      "default": "./dist/outlet.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "!src/**/*.test.ts", "*.md"],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
